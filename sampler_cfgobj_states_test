# load a sampler cfgobj A
#   -> assert(state == INIT)
# configure A
#   -> assert(state == CONFIGURED)
# start A
#   -> assert(state == RUNNING)
# stop A
#   -> assert(state == CONFIGURED)
# term A
#   -> assert(state == TERMINATING)
case_id = assertion_id_get()

# Load -> INIT
TEST_INIT_STATE = next(case_id)
test.add_assertion(TEST_INIT_STATE, "State is INIT after load")

# config -> CONFIGURED
TEST_CONFIG_STATE = next(case_id)
test.add_assertion(TEST_CONFIG_STATE, "State is CONFIGURED after config")

# start -> RUNNING
TEST_RUNNING_STATE = next(case_id)
test.add_assertion(TEST_RUNNING_STATE, "State is RUNNING after start")

# stop -> CONFIGURED
TEST_STOP_STATE = next(case_id)
test.add_assertion(TEST_STOP_STATE, "State is CONFIGURED after stop")

# term -> TERMINATING
TEST_TERM_STATE = next(case_id)
test.add_assertion(TEST_TERM_STATE, "State is TERMINATING after term")

# load -> config -> start -> stop -> term
TEST_FULL_LIFECYCLE = next(case_id)
test.add_assertion(TEST_FULL_LIFECYCLE, "Complete lifecycle from load to term")
# load -> term
#   -> assert(success)
TEST_TERM_FROM_INIT = next(case_id)
test.add_assertion(TEST_TERM_FROM_INIT, "Terminate immediately after load")
# load -> config -> term
#   -> assert(success && state == TERMINATING)
TEST_TERM_AFTER_CONFIG = next(case_id)
test.add_assertion(TEST_TERM_AFTER_CONFIG, "Terminate after configuration")
# load -> config -> stop
#   -> assert(success && state == CONFIGURED)
TEST_STOP_AFTER_CONFIG = next(case_id)
test.add_assertion(TEST_STOP_AFTER_CONFIG, "Stop without starting")
# load -> stop
#   -> assert(success && state == INIT)
TEST_STOP_AFTER_LOAD = next(case_id)
test.add_assertion(TEST_STOP_AFTER_LOAD, "Stop before configuration")
# load -> config -> config
#   -> assert(success && state == CONFIGURED)
TEST_RECONFIG_AFTER_CONFIG = next(case_id)
test.add_assertion(TEST_RECONFIG_AFTER_CONFIG, "Reconfigure while in configured state")
# load -> start -> stop -> config
#  -> assert(success && state == CONFIGURED) # need to be configured first
TEST_RECONFIG_AFTER_STOP = next(case_id)
test.add_assertion(TEST_RECONFIG_AFTER_STOP, "Reconfigure after stopping")
# load -> start
#  -> assert(failed && state == INIT) # need to be configured first
TEST_START_AFTER_LOAD = next(case_id)
test.add_assertion(TEST_START_AFTER_LOAD, "Start wihtout configuration (fails)")
# load -> config -> start -> term
#  -> assert(failed && state == RUNNING)
TEST_TERM_AFTER_START = next(case_id)
test.add_assertion(TEST_TERM_AFTER_START, "Ternimate while running (fails)")
# load -> config -> start -> config
#  -> assert(failed && state == RUNNING)
TEST_CONFIG_AFTER_START = next(case_id)
test.add_assertion(TEST_CONFIG_AFTER_START, "Configure while running (fails)")

def ldmsd_request_send(cont, cfg):
    cmd = f"python3 /tada-src/python/ldmsd_request_send.py"
    cmd += f" -x {LDMSD_XPRT} -p {LDMSD_PORT} -H localhost"
    cmd += f" --cmd '{cfg}'"
    return cont.exec_run(cmd)

def load_smp(cont, name, plugin=None):
    cfg = f"load name={name}"
    if plugin is not None:
        cfg += f" plugin={plugin}"
    return ldmsd_request_send(cont, cfg)

def config_smp(cont, name, producer = None, instance = None, **kwargs):
    cfg = f"config name={name}"
    if producer is not None:
        cfg += f" producer={producer}"
    if instance is not None:
        cfg += f" instance={instance}"
    if len(kwargs) > 0:
        for k, v in kwargs.items():
            cfg += f" {k}={v}"
    return ldmsd_request_send(cont, cfg)

def start_smp(cont, name, interval="1s"):
    cfg = f"start name={name} interval={interval}"
    return ldmsd_request_send(cont, cfg)

def stop_smp(cont, name):
    cfg = f"stop name={name}"
    return ldmsd_request_send(cont, cfg)

def term_smp(cont, name):
    cfg = f"term name={name}"
    return ldmsd_request_send(cont, cfg)

def smp_status_get(cont, name):
    cfg = f"smplr_status name={name}"
    rc, out = ldmsd_request_send(cont, cfg)
    return rc, out

def smp_state_get(cont, name):
    rc, out = smp_status_get(cont, name)
    if rc != 0:
        raise RuntimeError(f"Failed to get the status of sampler '{name}'. {out}")
    d = json.loads(out)
    return d[0]['state']

def smp_exist(cont, name):
    rc, out = smp_status_get(cont, name)
    if rc:
        if rc == errno.ENOENT:
            return False
        else:
            raise RuntimeError(f"Failed to get the status of sampler '{name}'. {out}")
    else:
        return True

def smp_name_get(id):
    return f"samp_{id}"

### Start ####
cluster = None
test.start()

@atexit.register
def at_exit():
    rc = test.finish()
    if cluster is not None:
        cluster.remove()
    os._exit(rc)

