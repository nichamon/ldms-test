if rc != 0:
    raise RuntimeError(f"Failed to load a sampler cfgobj: {out}")
rc, out = config_smp(node1, name= smp, action="default", producer = node1.name, instance = f"{node1.name}/{smp}")
if rc != 0:
    raise RuntimeError(f"Failed to config a sampler cfgobj: {out}")
rc, out = term_smp(node1, name = smp)
is_exist = smp_exist(node1, name=smp)
test.assert_test(TEST_TERM_AFTER_CONFIG, rc == 0 and is_exist == False, "load->config->term works")

# TEST_STOP_AFTER_CONFIG
smp = smp_name_get(TEST_STOP_AFTER_CONFIG)
rc, out = load_smp(node1, name = smp, plugin = "test_sampler")
if rc != 0:
    raise RuntimeError(f"Failed to load a sampler cfgobj: {out}")
rc, out = config_smp(node1, name = smp, action="default", producer = node1.name, instance = f"{node1.name}/{smp}")
if rc != 0:
    raise RuntimeError(f"Failed to config a sampler cfgobj: {out}")
rc, out = stop_smp(node1, name = smp)
state = smp_state_get(node1, name=smp)
test.assert_test(TEST_STOP_AFTER_CONFIG, rc != 0 and state == "CONFIGURED", "load->config->stop errors")

# TEST_STOP_AFTER_LOAD
smp = smp_name_get(TEST_STOP_AFTER_LOAD)
rc, out = load_smp(node1, name =smp, plugin = "test_sampler")
if rc != 0:
    raise RuntimeError(f"Failed to load a sampler cfgobj: {out}")
rc, out = stop_smp(node1, name = smp)
state = smp_state_get(node1, name=smp)
