# TEST_TERM_AFTER_START
smp = smp_name_get(TEST_TERM_AFTER_START)
rc, out = load_smp(node1, name = smp, plugin = "test_sampler")
if rc != 0:
    raise RuntimeError(f"Failed to load a sampler cfogbj: {out}")
