# TEST FULL LIFECYCLE
smp = smp_name_get(TEST_FULL_LIFECYCLE)
rc, out = load_smp(node1, name = smp, plugin = "test_sampler")
if rc != 0:
    test.assert_test(TEST_FULL_LIFECYCLE, rc == 0, "Load successfully")
state = smp_state_get(node1, name = smp)
test.assert_test(TEST_INIT_STATE, state == "INIT", "state == INIT")

rc, out = config_smp(node1, name = smp, action="default", producer=node1.name, instance=f"{node1.name}/{smp}")
if rc != 0:
    test.assert_test(TEST_FULL_LIFECYCLE, rc == 0, "Config successfully")
state = smp_state_get(node1, name=smp)
test.assert_test(TEST_CONFIG_STATE, state == "CONFIGURED", "state == CONFIGURED")

rc, out = start_smp(node1, name=smp)
if rc != 0:
    test.assert_test(TEST_FULL_LIFECYCLE, rc == 0, "Start successfully")
state = smp_state_get(node1, name=smp)
test.assert_test(TEST_RUNNING_STATE, state == "RUNNING", "state == RUNNING")
time.sleep(5)

rc, out = stop_smp(node1, name=smp)
if rc != 0:
    test.assert_test(TEST_FULL_LIFECYCLE, rc == 0, "Stop successfully")
state = smp_state_get(node1, name=smp)
test.assert_test(TEST_STOP_STATE, state == "CONFIGURED", "state == CONFIGURED")

rc, out = term_smp(node1, name=smp)
if rc != 0:
    test.assert_test(TEST_FULL_LIFECYCLE, rc == 0, "Term successfully")
is_exist = smp_exist(node1, name=smp)
test.assert_test(TEST_TERM_STATE, is_exist == False, "Sampler does not exist after term")
test.assert_test(TEST_FULL_LIFECYCLE, True, "load->config->start->stop->term works")

# TERM AFTER INIT
smp = smp_name_get(TEST_TERM_FROM_INIT)
rc, out = load_smp(node1, name = smp, plugin = "test_sampler")
if rc != 0:
    raise RuntimeError(f"Failed to load a sampler cfgobj: {out}")
rc, out = term_smp(node1, name = smp)
is_exist = smp_exist(node1, name=smp)
test.assert_test(TEST_TERM_FROM_INIT, rc == 0 and is_exist == False, "load->term works")

# TEST_TERM_AFTER_CONFIG
smp = smp_name_get(TEST_TERM_AFTER_CONFIG)
