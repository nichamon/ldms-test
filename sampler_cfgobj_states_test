#!/usr/bin/env python3

# The test script is to test whether ldmsd honors the state diagram of
# sampler cfgobj.
#
# State Diagram:
#                                      |
#                                     load
#                                      |
#                                      v
#   -------------                   ------
#  | TERMINATING |<----- term -----| INIT |
#   -------------                   ------
#         ^                            |
#         |                          config
#         |                            |
#         |                            v
#         |                       ------------
#         +-------- term --------| CONFIGURED |<---+----+
#                                 ------------     |    |
#                                   |    |         |    |
#                                 start  |         |    |
#                                   |    +-----config   |
#                                   v                   |
#                               ---------               |
#                              | RUNNING |              |
#                               ---------               |
#                                   |                   |
#                                  stop                 |
#                                   |                   |
#                                   +-------------------+


# load a sampler cfgobj A
#   -> assert(state == INIT)
# configure A
#   -> assert(state == CONFIGURED)
# start A
#   -> assert(state == RUNNING)
# stop A
#   -> assert(state == CONFIGURED)
# term A
#   -> assert(state == TERMINATING)
#
# load a sampler cfgobj B and then term B
#   -> assert(success)
#
# load a sampler cfgobj C and configure C and term C
#   -> assert(success && state == TERMINATING)
#
# load a sampler cfgobj D and configure D and stop D
#   -> assert(success && state == CONFIGURED)
#
# load a sampler cfgobj E and stop E
#   -> assert(success && state == INIT)
#
# load a sampler cfgobj and configure and configure
#   -> assert(success && state == CONFIGURED)
#
# load a sampler cfgobj F and start F
#  -> assert(failed && state == INIT) # need to be configured first
#
# load a sampler cfgobj G and config G and start G and term G
#  -> assert(failed && state == RUNNING)
#
# load a sampler cfgobj H and config H and start H and config H
#  -> assert(failed && state == RUNNING)

