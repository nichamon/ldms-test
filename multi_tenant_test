#### helper functions #### ------------------------------------------
"""
Helper functions for tenant definition management and verification.

Verification Functions:
- verify_tenant_set_exists(): Check if tenant set exists
- verify_tenant_set_name(): Validate tenant set naming format
- verify_tenant_set_schema_name(): Validate tenant set schema name
- verify_job_in_tenant_set(): Check if job data appears in tenant set
- verify_tenant_record_def(): Validate tenant records match definition
- verify_tenant_isolated_from_sampler(): Ensure tenant data doesn't leak to sampler sets
- verify_tenant_set_deleted(): Confirm tenant set deletion

Utility Functions:
- daemon_name_get(): Generate daemon identifier
- tenant_set_name_get(): Generate tenant set name
- send_request(): Send command to ldmsd
- submit_job(): Submit SLURM job for testing
- query_ldms_ls(): Query LDMS metadata
- tenant_set_get(): Retrieve specific tenant set data
- is_job_in_tenant(): Check if job exists in tenant data
- cleanup_db(): Clear test database
"""
def daemon_name_get(node_name):
    return f"{node_name}:{LDMSD_PORT}"

def tenant_set_name_get(node_name, tenant_def_name):
    return f"{daemon_name_get(node_name)}/{tenant_def_name}"

def tenant_set_get(ls_output, node_name, tenant_def_name):
    set_name = tenant_set_name_get(node_name, tenant_def_name)
    tset = ls_output[set_name]
    return tset

def is_job_in_tenant(tset, job_id):
    tenants = tset['data']['tenants']
    for t in tenants:
        if f"slurm_{job_id}" == t['job_id']:
            return True
    return False

def send_request(cont, cmd):
    """Send ldmsd_controller command to container"""
    rc, out = cont.config_ldmsd(cmd)
    return rc, out

def cleanup_db(cluster):
    cont = cluster.get_container("headnode")
    cont.exec_run(f"rm -rf /db/*")

def submit_job(cluster, num_tasks, sleep_sec = 10):
    """Submit SLURM job"""
    cont = cluster.get_container("headnode")
    script_path = f"/db/job_t{num_tasks}_s{sleep_sec}.sh"
    cont.write_file(script_path,
                    f'#!/bin/bash\n'
                    f'#SBATCH -n {num_tasks}\n'
                    f'#SBATCH -D /db\n'
                    f'srun sleep {sleep_sec}\n')
    log.info(f"Submitting job with {num_tasks} tasks")
    jobid = cluster.sbatch(script_path)
    log.info(f"Job submitted with jobid={jobid}")
    return jobid

def query_ldms_ls(cont, host = "localhost", xprt = LDMSD_XPRT, port = LDMSD_PORT, lookup = False):
    cmd = f"/{TADA_SRC}/python/ldms_ls.py -x {xprt} -p {port} -h {host}"

    if lookup:
        cmd += f" --lookup"

    rc, out = cont.exec_run(cmd)
    if rc:
          raise Exception(f"'{cmd}' failed with error {rc}: {out}")
    return json.loads(out)

class TenantDef(object):
    def __init__(self, name, metrics):
        self.name = name
        self.metrics = metrics if metrics else []

    def to_tenant_add_cmd(self):
        """Generate ldmsd config commands to create this tenant"""
        cmd = f"tenant_add name={self.name}"
        if self.metrics and len(self.metrics) > 0:
            cmd += f" metrics={','.join(self.metrics)}"
        return cmd

    def __repr__(self):
        return f"tenantDef(name={self.name}, metrics={self.metrics})"

TENANT_DEF_JOB = TenantDef("tenant_job", ["job_id"])
TENANT_DEF_JOB_STEP_TASK = TenantDef("tenant_job_step_task", ["job_id", "task_id", "step_id"])

def verify_tenant_set_exists(cluster, node_name, tenant_def_name):
    """Verify tenant set exists"""
    cont = cluster.get_container(node_name)
    output = query_ldms_ls(cont)
    if any(tenant_def_name in item for item in output.keys()):
        return True
    D.breakpoint()
    return False

def verify_tenant_set_name(cluster, node_name, tenant_def_name):
    """Verify tenant set name"""
    cont = cluster.get_container(node_name)
    output = query_ldms_ls(cont)
    set_name = tenant_set_name_get(node_name, tenant_def_name)
    if set_name in output.keys():
        return True
    D.breakpoint()
    return False

def verify_tenant_set_schema_name(cluster, node_name, tenant_def_name):
    """Verify the schema name of the tenant set"""
    cont = cluster.get_container(node_name)
    output = query_ldms_ls(cont)
    set_name = tenant_set_name_get(node_name, tenant_def_name)
    if output[set_name]['schema_name'] == tenant_def_name:
        return True
    D.breakpoint()
    return False

def verify_job_in_tenant_set(cluster, node_name, tenant_def, metric_kv):
    """Verify job appears in tenant set"""
    cont = cluster.get_container(node_name)
    output = query_ldms_ls(cont, lookup = True)
    tset = tenant_set_get(output, node_name, tenant_def.name)
    metrics = tset['data']['tenants']
    for m in metrics:
        for k, v in metric_kv.items():
            if m[k] != f'slurm_{v}':
                break
            return True
    D.breakpoint()
    return False

def verify_tenant_record_def(cluster, node_name, tenant_def):
    """Verify tenant records contain metrics according to the tenant definition"""
    cont = cluster.get_container(node_name)
    output = query_ldms_ls(cont, lookup = True)
    tset = tenant_set_get(output, node_name, tenant_def.name)
    tenants = tset['data']['tenants']
    if set(tenants[0].keys()) == set(tenant_def.metrics):
        return True
    D.breakpoint()
    return False

def verify_number_tenants(cluster, node_name, tenant_def, exp_number):
    """Verify the number of tenants are corrected populated"""
    cont = cluster.get_container(node_name)
    output = query_ldms_ls(cont, lookup = True)
    tset = tenant_set_get(output, node_name, tenant_def.name)
    tenants = tset['data']['tenants']
    if len(tenants) == exp_number:
        return True
    D.breakpoint()
    return False

def verify_tenant_isolated_from_sampler(cluster, node_name, tenant_set, sampler_set, jobid):
    """Verify tenant data not in sampler set"""
    cont = cluster.get_container(node_name)
    output = query_ldms_ls(cont)
    if output and str(jobid) not in output:
        return True
    D.breakpoint()
    return False

def verify_tenant_set_deleted(cont, set_name):
    """Verify tenant set is deleted"""
    rc, out = cont.exec_run(f"ldms_ls -l -v {set_name}")
    if rc != 0:  # Should fail
        return True
    D.breakpoint()
    return False

